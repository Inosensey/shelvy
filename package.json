{
  "name": "Shelvy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=apps/api",
    "dev:frontend": "npm run dev --workspace=apps/web",
    "test": "turbo run test",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up --build",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:backend": "docker-compose logs -f backend",
    "docker:logs:frontend": "docker-compose logs -f frontend",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:prune": "docker system prune -af",
    "docker:up": "npm run docker:dev",
    "docker:down": "npm run docker:dev:down",
    "docker:rebuild": "docker-compose down && docker-compose build --no-cache",
    "docker:prisma:studio": "docker-compose exec -w /app/apps/api backend npx prisma studio",
    "docker:prisma:migrate": "docker-compose exec -w /app/apps/api backend npx prisma migrate dev",
    "docker:prisma:generate": "docker-compose exec -w /app/apps/api backend npx prisma generate",
    "docker:prisma:reset": "docker-compose exec -w /app/apps/api backend npx prisma migrate reset",
    "start": "npm run docker:prod",
    "start:dev": "npm run docker:dev",
    "start:web": "cd apps/web && npm run start",
    "start:api": "cd apps/api && npm run start:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
