# --- BUILD STAGE ---
FROM node:22-alpine AS builder
WORKDIR /app

# Upgrade npm globally to match your project's strict devEngines requirement
RUN npm install -g npm@11.18.0

# Copy root and app configuration files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api/package*.json ./apps/api/

# Install ALL dependencies
RUN npm ci

# Copy Prisma schema and source files
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api ./apps/api

# Generate Prisma Client and build the NestJS app using Turborepo
RUN npx prisma generate --schema=./apps/api/prisma/schema.prisma
RUN npx turbo run build --filter=api

# --- PRODUCTION STAGE ---
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Upgrade npm globally here as well to avoid validation errors
RUN npm install -g npm@11.18.0

# Copy configuration files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma

# Install ONLY production dependencies
RUN npm ci --omit=dev

# Copy the Prisma engine from the specific workspace directory where it was generated
COPY --from=builder /app/apps/api/node_modules/.prisma ./apps/api/node_modules/.prisma
COPY --from=builder /app/apps/api/node_modules/@prisma/client ./apps/api/node_modules/@prisma/client
COPY --from=builder /app/apps/api/dist ./apps/api/dist

EXPOSE 3001

# Run migrations automatically right before booting up the server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=./apps/api/prisma/schema.prisma && node apps/api/dist/main.js"]
