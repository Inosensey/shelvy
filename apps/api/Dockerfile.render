# --- BUILD STAGE ---
FROM node:22-alpine AS builder
WORKDIR /app

# Upgrade npm globally to match your project's strict devEngines requirement
RUN npm install -g npm@11.18.0

# Copy root and app configuration files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api/package*.json ./apps/api/

# Install ALL dependencies
RUN npm ci

# Copy Prisma config, schema, and source files
COPY apps/api/prisma.config.ts ./apps/api/
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api ./apps/api

# Generate Prisma Client (outputs to apps/api/generated/prisma) and build using Turborepo
RUN npx prisma generate --schema=./apps/api/prisma/schema.prisma
RUN npx turbo run build --filter=api

# --- PRODUCTION STAGE ---
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Upgrade npm globally here as well
RUN npm install -g npm@11.17.0

# Copy configuration files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma

# Copy your prisma.config.ts from the correct workspace folder path
COPY apps/api/prisma.config.ts ./apps/api/

# Install ONLY production dependencies
RUN npm ci --omit=dev

# Ensure the correct production target folder exists in the runner stage
RUN mkdir -p apps/api/generated/prisma

# Copy from the exact path where Prisma generated the client
COPY --from=builder /app/apps/api/generated/prisma ./apps/api/generated/prisma
COPY --from=builder /app/apps/api/dist ./apps/api/dist

EXPOSE 3001

# Changed target from dist/main.js to dist/src/main.js to match NestJS workspace structure
CMD ["sh", "-c", "npx prisma migrate deploy --config=./apps/api/prisma.config.ts --schema=./apps/api/prisma/schema.prisma && node apps/api/dist/src/main.js"]
