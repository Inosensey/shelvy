# --- BUILD STAGE ---
# Upgraded to node:22-alpine to satisfy package engine requirements
FROM node:22-alpine AS builder
WORKDIR /app

# Copy root and app configuration files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api/package*.json ./apps/api/

# Install ALL dependencies
RUN npm ci

# Copy Prisma schema and source files
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api ./apps/api

# Generate Prisma Client and build the NestJS app
RUN npx prisma generate --schema=./apps/api/prisma/schema.prisma
RUN npm run build --workspace=apps/api

# --- PRODUCTION STAGE ---
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy configuration files
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma

# Install ONLY production dependencies
RUN npm ci --omit=dev

# Copy generated Prisma Client binary and compiled code from builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/apps/api/dist ./apps/api/dist

EXPOSE 3001

# Run migrations automatically right before booting up the server
CMD ["sh", "-c", "npx prisma migrate deploy --schema=./apps/api/prisma/schema.prisma && node apps/api/dist/main.js"]
