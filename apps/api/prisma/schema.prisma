// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String   @id @default(cuid())
  ownerId     String   @unique @map("owner_id")
  name        String
  description String?

  // Owner relationship
  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id])

  // Members
  users       User[]   @relation("OrganizationMembers")

  organizationInvites OrganizationInvite[]
  products            Product[]
  suppliers           Supplier[]
  notifications       Notification[] 

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationInvite {
  id             String     @id @default(uuid())
  email          String     
  organizationId String     @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           InviteRole 
  token          String     @unique 
  invitedById    String     @map("invited_by_id")
  invitedBy      User       @relation(fields: [invitedById], references: [id])
  expiresAt      DateTime   @map("expires_at")
  lastResentAt   DateTime?  @map("last_resent_at")
  acceptedAt     DateTime?  @map("accepted_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  status         InviteStatus @default(PENDING)

  @@index([email])
  @@map("organization_invites")
}


model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String?
  avatar            String?

  stripeCustomerId  String   @default("") @map("stripe_customer_id")
  subscriptionPlan  SubscriptionPlan @default(FREE) @map("subscription_plan")
  role              Role     @default(STAFF)
  authProvider      AuthProvider @default(LOCAL) @map("auth_provider")

  // Organization the user belongs to
  organizationId    String?  @map("organization_id")
  organization      Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id])

  // Organization owned by this user
  ownedOrganization Organization? @relation("OrganizationOwner")

  organizationInvites OrganizationInvite[]
  stockMovements      StockMovement[]
  sessions            Session[]
  usersInfo           UserInfo[]
  subscriptions       Subscription[]
  notifications       Notification[] 

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model UserInfo {
  id          Int      @id @default(autoincrement())
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id])

  firstName   String   @map("first_name")
  middleName  String?  @map("middle_name")
  lastName    String   @map("last_name")
  suffix      String?

  birthDate   DateTime? @map("birth_date")
  gender      String?

  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?  @map("postal_code")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("users_info")
}

model Session {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  token           String         @unique

  expiresAt       DateTime       @map("expires_at")
  isValid         Boolean        @default(true) @map("is_valid")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User           @relation(fields: [userId], references: [id])
  
  @@map("sessions")
  @@index([userId])
  @@index([expiresAt])
  @@index([isValid])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  
  // Stripe related
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripeCustomerId     String? @map("stripe_customer_id")
  stripePriceId        String? @map("stripe_price_id")
  
  // Subscription details
  plan               SubscriptionPlan   @default(FREE)
  amount             Decimal            @default(0.0)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  
  // Payment tracking
  lastPaymentDate  DateTime? @map("last_payment_date")
  nextPaymentDate  DateTime? @map("next_payment_date")
  lastPaymentError String?   @map("last_payment_error")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  
  // Metadata
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  canceledAt DateTime? @map("canceled_at")
  
  // Relations
  subscriptionPayments SubscriptionPaymentHistory[]
  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
  @@index([status])
  @@index([nextPaymentDate])
}

model SubscriptionPaymentHistory {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")

  // Stripe info
  stripeInvoiceId       String? @unique @map("stripe_invoice_id")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // Payment details
  amount        Int                  // in cents, e.g. 2999 = \$29.99
  currency      String  @default("usd")
  status        PaymentStatus @default(COMPLETED)
  failureReason String? @map("failure_reason")

  // Period this payment covers
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_payments_history")
  @@index([subscriptionId])
}

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?
  price             Decimal
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")

  organizationId    String   @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id])

  supplierId        String?  @map("supplier_id")
  supplier          Supplier? @relation(fields: [supplierId], references: [id])

  stockMovements    StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?

  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  products  Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
}

model StockMovement {
  id            String        @id @default(cuid())
  type          MovementType  // IN, OUT, ADJUSTMENT
  quantity      Int           // how many units moved
  reason        String?       // why it happened
  note          String?       // extra context

  productId     String        @map("product_id")
  product       Product @relation(fields: [productId], references: [id])

  performedById String        @map("performed_by_id")
  performedBy   User @relation(fields: [performedById], references: [id])

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("stock_movements")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id") // who receives it
  type           NotificationType
  title          String
  message        String
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")
  metadata       Json?

  // Relationship lines (keep your original @relation definitions inside the parenthesis)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// Enums
enum PaymentStatus {
  COMPLETED
  FAILED
  REFUNDED
  PENDING
}
enum SubscriptionPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  INCOMPLETE
}

enum InviteRole {
  MANAGER
  STAFF
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum NotificationType {
  MEMBER_JOINED
  LOW_STOCK
  STOCK_MOVEMENT
  PAYMENT_FAILED
}