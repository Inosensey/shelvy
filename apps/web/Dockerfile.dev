# apps/web/Dockerfile.dev
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY turbo.json ./

# Install dependencies
RUN npm install --workspace=apps/web

EXPOSE 3000 24678

# Default command
CMD ["npm", "run", "dev", "--workspace=apps/web"]